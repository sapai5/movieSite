{
  "name": "movieplayer-desktop",
  "productName": "MoviePlayer",
  "version": "1.0.0",
  "description": "MoviePlayer desktop app with built-in ad blocking",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:smoke": "electron . --smoke-test",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "app.movieplayer.desktop",
    "productName": "MoviePlayer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MoviePlayer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MoviePlayer-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
